# Copy to Server/.env (ignored by Git). Existing process variables take precedence.
# Values are literal; no shell substitution or inline comments.
SERVER_PORT=18080
DB_URL=jdbc:mysql://localhost:3306/fragpicker?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=fragpicker
DB_PASSWORD=
JWT_SIGNING_KEY=

# DeepSeek key may already be configured in your terminal environment.
AI_CHAT_ENABLED=true
AI_CHAT_BASE_URL=https://api.deepseek.com
AI_CHAT_MODEL=deepseek-flash
AI_CHAT_API_KEY=
KNOWLEDGE_ENRICHMENT_ENABLED=true
KNOWLEDGE_INDEX_ENABLED=true
DIGEST_WORKER_ENABLED=true
DIGEST_SCHEDULE_ENABLED=true

# Parse links now; remaining media/transcription stages wait until cloud is configured.
PARSEVIDEO_ENABLED=true
PARSEVIDEO_BASE_URL=http://39.108.121.101:8001/
INGESTION_WORKER_ENABLED=true
OSS_ENABLED=false
MEDIA_WORKER_ENABLED=false
TINGWU_ENABLED=false
TRANSCRIPTION_WORKER_ENABLED=false
MEDIA_CLEANUP_ENABLED=false

# To enable the full pipeline later, configure the following credentials locally,
# then set OSS/MEDIA_WORKER/TINGWU/TRANSCRIPTION_WORKER/MEDIA_CLEANUP_ENABLED=true.
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_BUCKET=fragpicker
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
TINGWU_APP_KEY=
